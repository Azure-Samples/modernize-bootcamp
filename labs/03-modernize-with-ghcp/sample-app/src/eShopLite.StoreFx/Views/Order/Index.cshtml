@using eShopLite.StoreFx.Models
@model IEnumerable<Order>
@{
  ViewBag.Title = "My Orders";
  var summary = ViewBag.Summary as OrderSummary;
}
<main aria-labelledby="title">
  <h2 id="title">@ViewBag.Title</h2>

  @if (summary != null)
  {
    <div class="row mb-4">
      <div class="col-md-4">
        <div class="border rounded p-3 h-100">
          <div class="text-muted small">Orders placed</div>
          <div class="fs-4">@summary.OrderCount</div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="border rounded p-3 h-100">
          <div class="text-muted small">Lifetime total</div>
          <div class="fs-4">USD @summary.LifetimeTotal.ToString("N2")</div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="border rounded p-3 h-100">
          <div class="text-muted small">First order</div>
          <div class="fs-4">
            @(summary.FirstOrderUtc.HasValue ? summary.FirstOrderUtc.Value.ToString("yyyy-MM-dd") : "\u2014")
          </div>
        </div>
      </div>
    </div>
  }

  @if (Model == null || !Model.Any())
  {
    <p><em>You have not placed any orders yet.</em></p>
    <p><a asp-controller="Home" asp-action="Products" class="btn btn-primary">Browse products</a></p>
  }
  else
  {
    <table class="table align-middle">
      <thead>
        <tr>
          <th>Order</th>
          <th>Placed (UTC)</th>
          <th class="text-center">Items</th>
          <th class="text-end">Total</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        @foreach (var order in Model)
        {
          <tr>
            <td>#@order.Id</td>
            <td>@order.PlacedUtc.ToString("yyyy-MM-dd HH:mm")</td>
            <td class="text-center">@order.Lines.Sum(l => l.Quantity)</td>
            <td class="text-end">USD @order.Total.ToString("N2")</td>
            <td class="text-end">
              <a asp-controller="Cart" asp-action="Confirmation" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary">View receipt</a>
            </td>
          </tr>
        }
      </tbody>
    </table>
  }
</main>
