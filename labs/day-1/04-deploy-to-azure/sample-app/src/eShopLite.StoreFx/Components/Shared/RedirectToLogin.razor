@inject NavigationManager Navigation

@code {
    // Replaces the cookie handler's LoginPath redirect: authorization now fails inside the
    // component tree, where no HTTP challenge is in flight to redirect.
    protected override void OnInitialized()
    {
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);

        Navigation.NavigateTo($"/account/login?returnUrl={Uri.EscapeDataString(returnUrl)}", replace: true);
    }
}
