@{
    ViewBag.Title = "Home Page";
}

<main>
    <section class="row mb-4" aria-labelledby="title">
        <div class="col">
            <h1 id="title">eShopLite</h1>
            <p class="lead">
                A small outdoor-gear storefront: browse and search a product catalogue, open a product
                for the full details, add items to a cart, check out as a signed-in user, and look back
                over everything you have ordered.
            </p>
            <p>
                <a href="@Url.Action("Products", "Home")" class="btn btn-primary btn-md">Browse products &raquo;</a>
            </p>
        </div>
    </section>

    <div class="row">
        <section class="col-md-4" aria-labelledby="shopTitle">
            <h2 id="shopTitle">Shop</h2>
            <p>
                Search the catalogue by name or description, open any product for its full details, then
                pick a quantity and add to your cart. The cart lives in your session, so it survives
                signing in and follows you until you check out.
            </p>
            <p><a class="btn btn-outline-dark" href="@Url.Action("Products", "Home")">Products &raquo;</a></p>
        </section>
        <section class="col-md-4" aria-labelledby="storesTitle">
            <h2 id="storesTitle">Stores</h2>
            <p>
                Nine locations, each with its own city and opening hours &mdash; the physical side of
                the catalogue.
            </p>
            <p><a class="btn btn-outline-dark" href="@Url.Action("Stores", "Home")">Stores &raquo;</a></p>
        </section>
        <section class="col-md-4" aria-labelledby="ordersTitle">
            <h2 id="ordersTitle">Your orders</h2>
            <p>
                Every order you have placed, newest first, with a running lifetime total and a link
                back to each receipt. Sign in to see yours &mdash; you only ever see your own.
            </p>
            <p><a class="btn btn-outline-dark" href="@Url.Action("Index", "Order")">My orders &raquo;</a></p>
        </section>
    </div>

    <hr />

    <div class="row">
        <section class="col-md-6" aria-labelledby="aboutTitle">
            <h2 id="aboutTitle">About eShopLite</h2>
            <p>
                Everything the storefront does is reachable from the tabs above: <strong>Products</strong>
                for the catalogue and product details, <strong>Stores</strong> for our locations and
                opening hours, and <strong>My orders</strong> for your order history once you are
                signed in.
            </p>
        </section>
        <section class="col-md-6" aria-labelledby="signInTitle">
            <h2 id="signInTitle">Signing in</h2>
            <p>Browsing and adding to the cart are open to everyone; checkout requires an account. Once you are signed in, your past orders are available under <strong>My orders</strong>.</p>
        </section>
    </div>
</main>
