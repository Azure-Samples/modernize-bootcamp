@using eShopLite.StoreFx.Models
@model Order
@{
  ViewBag.Title = "Order Confirmed";
}
<main aria-labelledby="title">
  <h2 id="title">@ViewBag.Title</h2>

  <div class="alert alert-success">
    Thanks, <strong>@User.Identity.Name</strong> &mdash; order <strong>#@Model.Id</strong> was placed on
    @Model.PlacedUtc.ToString("yyyy-MM-dd HH:mm") UTC.
  </div>

  <table class="table">
    <thead>
      <tr>
        <th>Item</th>
        <th class="text-center">Qty</th>
        <th class="text-end">Unit price</th>
        <th class="text-end">Line total</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var line in Model.Lines)
      {
        <tr>
          <td>@line.ProductName</td>
          <td class="text-center">@line.Quantity</td>
          <td class="text-end">USD @line.UnitPrice.ToString("N2")</td>
          <td class="text-end">USD @((line.UnitPrice * line.Quantity).ToString("N2"))</td>
        </tr>
      }
    </tbody>
    <tfoot>
      <tr>
        <th colspan="3" class="text-end">Total</th>
        <th class="text-end">USD @Model.Total.ToString("N2")</th>
      </tr>
    </tfoot>
  </table>

  @Html.ActionLink("Continue shopping", "Products", "Home", null, new { @class = "btn btn-primary" })
</main>
