@using eShopLite.StoreFx.Models
@model Cart
@{
  ViewBag.Title = "Your Cart";
}
<main aria-labelledby="title">
  <h2 id="title">@ViewBag.Title</h2>

  @if (TempData["CartMessage"] != null)
  {
    <div class="alert alert-@(TempData["CartMessageKind"] ?? "success")">@TempData["CartMessage"]</div>
  }

  @if (Model.IsEmpty)
  {
    <p><em>Your cart is empty.</em></p>
    <p>@Html.ActionLink("Browse products", "Products", "Home", null, new { @class = "btn btn-primary" })</p>
  }
  else
  {
    <table class="table align-middle">
      <thead>
        <tr>
          <th>Item</th>
          <th class="text-end">Unit price</th>
          <th class="text-center">Qty</th>
          <th class="text-end">Line total</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        @foreach (var item in Model.Items)
        {
          <tr>
            <td>
              <img src="~/images/@item.ImageUrl" alt="@item.Name" width="60" class="me-2" />
              @item.Name
            </td>
            <td class="text-end">USD @item.UnitPrice.ToString("N2")</td>
            <td class="text-center">
              @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { @class = "d-flex gap-2 justify-content-center align-items-center" }))
              {
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@item.ProductId" />
                <label class="visually-hidden" for="cart-qty-@item.ProductId">Quantity for @item.Name</label>
                <input type="number" id="cart-qty-@item.ProductId" name="quantity" value="@item.Quantity"
                       min="1" class="form-control form-control-sm" style="width: 5rem;" />
                <button type="submit" class="btn btn-sm btn-outline-secondary">Update</button>
              }
            </td>
            <td class="text-end">USD @item.LineTotal.ToString("N2")</td>
            <td class="text-end">
              @using (Html.BeginForm("Remove", "Cart", FormMethod.Post))
              {
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@item.ProductId" />
                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
              }
            </td>
          </tr>
        }
      </tbody>
      <tfoot>
        <tr>
          <th colspan="3" class="text-end">Total</th>
          <th class="text-end">USD @Model.Total.ToString("N2")</th>
          <th></th>
        </tr>
      </tfoot>
    </table>

    <div class="d-flex justify-content-between">
      @Html.ActionLink("Continue shopping", "Products", "Home", null, new { @class = "btn btn-outline-secondary" })
      @Html.ActionLink("Checkout", "Checkout", "Cart", null, new { @class = "btn btn-primary" })
    </div>
  }
</main>
