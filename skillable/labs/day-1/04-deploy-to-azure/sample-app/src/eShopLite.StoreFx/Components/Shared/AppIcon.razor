@* Inline SVG sprite. Keeps the icon set self-hosted - the MVC app pulled Bootstrap Icons from a CDN. *@

<svg xmlns="http://www.w3.org/2000/svg" width="@Size" height="@Size" viewBox="0 0 24 24"
     fill="none" stroke="currentColor" stroke-width="@StrokeWidth" stroke-linecap="round"
     stroke-linejoin="round" class="@Class" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "cart":
            <circle cx="9" cy="20" r="1.4" />
            <circle cx="18" cy="20" r="1.4" />
            <path d="M2 3h2.2l2.3 11.2a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 2-1.55L21 7H5.4" />
            break;
        case "search":
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.2-3.2" />
            break;
        case "store":
            <path d="M3 9.5 4.6 4h14.8L21 9.5" />
            <path d="M3 9.5a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0" />
            <path d="M5 12v8h14v-8" />
            <path d="M10 20v-5h4v5" />
            break;
        case "package":
            <path d="M21 8 12 3 3 8v8l9 5 9-5Z" />
            <path d="m3 8 9 5 9-5" />
            <path d="M12 13v8" />
            break;
        case "receipt":
            <path d="M6 2h12v20l-3-2-3 2-3-2-3 2Z" />
            <path d="M9 7h6M9 11h6M9 15h4" />
            break;
        case "user":
            <circle cx="12" cy="8" r="4" />
            <path d="M4 21a8 8 0 0 1 16 0" />
            break;
        case "logout":
            <path d="M15 3h3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-3" />
            <path d="M10 17 5 12l5-5" />
            <path d="M5 12h11" />
            break;
        case "chevron-down":
            <path d="m6 9 6 6 6-6" />
            break;
        case "arrow-right":
            <path d="M5 12h14" />
            <path d="m13 6 6 6-6 6" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "minus":
            <path d="M5 12h14" />
            break;
        case "trash":
            <path d="M4 7h16" />
            <path d="M10 11v6M14 11v6" />
            <path d="M6 7l1 13h10l1-13" />
            <path d="M9 7V4h6v3" />
            break;
        case "check":
            <path d="m5 13 4.5 4.5L19 7" />
            break;
        case "close":
            <path d="M6 6l12 12M18 6 6 18" />
            break;
        case "menu":
            <path d="M4 7h16M4 12h16M4 17h16" />
            break;
        case "eye":
            <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" />
            <circle cx="12" cy="12" r="3" />
            break;
        case "eye-off":
            <path d="M4 4l16 16" />
            <path d="M9.9 5.3A9.9 9.9 0 0 1 12 5c6.4 0 10 7 10 7a17 17 0 0 1-3.3 4.1" />
            <path d="M6.3 7.9A17 17 0 0 0 2 12s3.6 7 10 7a9.7 9.7 0 0 0 4.2-.9" />
            <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" />
            break;
        case "lock":
            <rect x="4" y="10" width="16" height="11" rx="2" />
            <path d="M8 10V7a4 4 0 0 1 8 0v3" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3.2 2" />
            break;
        case "pin":
            <path d="M12 21s7-5.7 7-11a7 7 0 1 0-14 0c0 5.3 7 11 7 11Z" />
            <circle cx="12" cy="10" r="2.6" />
            break;
        case "sparkle":
            <path d="M12 3v5M12 16v5M3 12h5M16 12h5" />
            <path d="m6.3 6.3 3 3M14.7 14.7l3 3M17.7 6.3l-3 3M9.3 14.7l-3 3" />
            break;
        case "alert":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7.5v5.5M12 16.2v.1" />
            break;
        default:
            <circle cx="12" cy="12" r="9" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; }

    [Parameter]
    public int Size { get; set; } = 18;

    [Parameter]
    public double StrokeWidth { get; set; } = 1.75;

    [Parameter]
    public string Class { get; set; }
}
