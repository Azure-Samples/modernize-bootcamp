@page "/cart"
@page "/cart/index"
@implements IDisposable
@inject CartState CartState
@inject ToastService Toasts

<PageTitle>Your cart - eShopLite</PageTitle>

<div class="page-head">
    <div>
        <h1>Your cart</h1>
        <p class="sub">Quantities update instantly &mdash; no page reloads.</p>
    </div>
</div>

@if (Cart.IsEmpty)
{
    <EmptyState Icon="cart"
                Title="Your cart is empty"
                Message="Add something from the catalogue and it will show up here."
                ActionText="Browse products"
                ActionHref="/products" />
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="panel">
                <table class="table-app">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th class="num">Unit price</th>
                            <th class="mid">Qty</th>
                            <th class="num">Line total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Cart.Items)
                        {
                            <tr @key="item.ProductId">
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img class="thumb" src="@ProductImage.UrlFor(item.ImageUrl)" alt="@item.Name" />
                                        <a href="@($"/products/{item.ProductId}")" class="fw-semibold">@item.Name</a>
                                    </div>
                                </td>
                                <td class="num">USD @item.UnitPrice.ToString("N2")</td>
                                <td class="mid">
                                    <div class="d-inline-flex">
                                        <QuantityStepper Value="item.Quantity"
                                                         ValueChanged="@(qty => UpdateQuantity(item.ProductId, qty))" />
                                    </div>
                                </td>
                                <td class="num fw-semibold">USD @item.LineTotal.ToString("N2")</td>
                                <td class="num">
                                    <button type="button" class="btn-danger-soft btn-sm"
                                            @onclick="() => Remove(item.ProductId, item.Name)"
                                            aria-label="@($"Remove {item.Name}")">
                                        <AppIcon Name="trash" Size="15" />
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-3">
                <a href="/products" class="btn-ghost">&larr; Continue shopping</a>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="summary-card">
                <h2 class="h5 mb-3">Order summary</h2>
                <div class="summary-line">
                    <span>Items</span>
                    <span>@Cart.ItemCount</span>
                </div>
                <div class="summary-line">
                    <span>Shipping</span>
                    <span>Calculated at checkout</span>
                </div>
                <div class="summary-total">
                    <span>Total</span>
                    <span>USD @Cart.Total.ToString("N2")</span>
                </div>
                <a href="/checkout" class="btn-app w-100 mt-3">
                    <AppIcon Name="lock" Size="16" /> Checkout
                </a>
                <p class="text-muted small text-center mt-3 mb-0">You will need to sign in to place the order.</p>
            </div>
        </div>
    </div>
}

@code {
    private Cart Cart => CartState.Cart;

    protected override void OnInitialized()
    {
        CartState.Changed += OnCartChanged;
    }

    private void OnCartChanged() => InvokeAsync(StateHasChanged);

    private void UpdateQuantity(int productId, int quantity)
    {
        CartState.SetQuantity(productId, quantity);
    }

    private void Remove(int productId, string name)
    {
        CartState.Remove(productId);
        Toasts.Show($"Removed \"{name}\" from your cart.", ToastKind.Info);
    }

    public void Dispose()
    {
        CartState.Changed -= OnCartChanged;
    }
}
