@page "/checkout"
@page "/cart/checkout"
@attribute [Authorize]
@inject CartState CartState
@inject IOrderService OrderService
@inject NavigationManager Navigation
@inject ToastService Toasts

<PageTitle>Checkout - eShopLite</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="page-head">
            <div>
                <h1>Checkout</h1>
                <p class="sub">Signed in as <strong>@context.User.Identity?.Name</strong></p>
            </div>
        </div>

        @if (Cart.IsEmpty)
        {
            <EmptyState Icon="cart"
                        Title="Nothing to check out"
                        Message="Your cart is empty."
                        ActionText="Browse products"
                        ActionHref="/products" />
        }
        else
        {
            @if (_error is not null)
            {
                <div class="alert-app error">
                    <AppIcon Name="alert" Size="18" />
                    <span>@_error</span>
                </div>
            }

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="panel">
                        <div class="panel-head">Order review</div>
                        <table class="table-app">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th class="mid">Qty</th>
                                    <th class="num">Line total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Cart.Items)
                                {
                                    <tr @key="item.ProductId">
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <img class="thumb" src="@ProductImage.UrlFor(item.ImageUrl)" alt="@item.Name" />
                                                <span class="fw-semibold">@item.Name</span>
                                            </div>
                                        </td>
                                        <td class="mid">@item.Quantity</td>
                                        <td class="num">USD @item.LineTotal.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-3">
                        <a href="/cart" class="btn-ghost">&larr; Back to cart</a>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="summary-card">
                        <h2 class="h5 mb-3">Payable now</h2>
                        <div class="summary-line">
                            <span>Items</span>
                            <span>@Cart.ItemCount</span>
                        </div>
                        <div class="summary-total">
                            <span>Total</span>
                            <span>USD @Cart.Total.ToString("N2")</span>
                        </div>
                        <button type="button" class="btn-app w-100 mt-3" disabled="@_placing" @onclick="PlaceOrder">
                            @if (_placing)
                            {
                                <span>Placing order&hellip;</span>
                            }
                            else
                            {
                                <AppIcon Name="check" Size="17" />
                                <span>Place order</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        }
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; }

    private bool _placing;
    private string _error;

    private Cart Cart => CartState.Cart;

    private async Task PlaceOrder()
    {
        if (_placing || Cart.IsEmpty)
        {
            return;
        }

        _placing = true;
        _error = null;

        try
        {
            var state = await AuthenticationState;
            var order = await OrderService.PlaceOrderAsync(Cart, state.User.Identity?.Name);

            CartState.Clear();
            Toasts.Show($"Order #{order.Id} placed. Thank you!");

            Navigation.NavigateTo($"/orders/{order.Id}");
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
            _placing = false;
        }
    }
}
